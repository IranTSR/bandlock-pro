<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f172a">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BandLock Pro"
            android:textAlignment="center"
            android:textColor="#3b82f6"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <!-- Connection Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1e293b"
            android:padding="20dp"
            android:elevation="10dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONNECTION STATUS"
                android:textColor="#94a3b8"
                android:textSize="14sp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="15dp">
                <TextView
                    android:id="@+id/tvRsrp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- dBm"
                    android:textColor="#f8fafc"
                    android:textSize="40sp"
                    android:textStyle="bold"/>
                <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                <TextView
                    android:id="@+id/tvCaBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5G NSA Active"
                    android:textColor="#10b981"
                    android:textStyle="bold"
                    android:visibility="gone"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:text="Band" android:textColor="#94a3b8" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/tvBand" android:text="--" android:textColor="#f8fafc" android:textSize="18sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:text="PCI" android:textColor="#94a3b8" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/tvPci" android:text="--" android:textColor="#f8fafc" android:textSize="18sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:text="EARFCN" android:textColor="#94a3b8" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/tvEarfcn" android:text="--" android:textColor="#f8fafc" android:textSize="18sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Current Lock State Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1a2744"
            android:padding="16dp"
            android:elevation="10dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 CURRENT LOCK STATE"
                android:textColor="#fbbf24"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvLockState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Checking..."
                android:textColor="#f8fafc"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Diagnostic Buttons -->
        <Button
            android:id="@+id/btnModemInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔍 DIAGNOSTIC: GET DEVICE CAP"
            android:backgroundTint="#475569"
            android:textColor="#f8fafc"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnListMbns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📜 LIST ALL MBN PROFILES"
            android:backgroundTint="#475569"
            android:textColor="#f8fafc"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnScanFsMbns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📂 SCAN MBN FILESYSTEM"
            android:backgroundTint="#475569"
            android:textColor="#f8fafc"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnInspectFs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔎 INSPECT MODEM FS &amp; PROPS"
            android:backgroundTint="#b91c1c"
            android:textColor="#f8fafc"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Logs -->
        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Waiting for Root..."
            android:textColor="#fca5a5"
            android:textSize="12sp"
            android:layout_marginBottom="16dp"/>

        <!-- Nearby Towers Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1e293b"
            android:padding="20dp"
            android:elevation="10dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📡 NEARBY TOWERS (RADAR)"
                android:textColor="#94a3b8"
                android:textSize="14sp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tvNeighbors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scanning for nearby cells..."
                android:textColor="#94a3b8"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Band Selection Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BAND SELECTION"
            android:textColor="#94a3b8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <!-- Single Band Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btnLock1"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="B1\n2100"
                android:textSize="12sp"
                android:layout_marginEnd="4dp"/>
            <Button
                android:id="@+id/btnLock3"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="B3\n1800"
                android:textSize="12sp"
                android:layout_marginEnd="4dp"/>
            <Button
                android:id="@+id/btnLock7"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="B7\n2600"
                android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btnLock8"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="B8\n900"
                android:textSize="12sp"
                android:layout_marginEnd="4dp"/>
            <Button
                android:id="@+id/btnLock28"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="B28\n700"
                android:textSize="12sp"
                android:layout_marginEnd="4dp"/>
            <Button
                android:id="@+id/btnLock40"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="B40\n2300"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Combo CA Bands -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btnLockB1B3"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="B1+B3"
                android:textSize="12sp"
                android:backgroundTint="#1e40af"
                android:layout_marginEnd="4dp"/>
            <Button
                android:id="@+id/btnLockB3B7"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="B3+B7"
                android:textSize="12sp"
                android:backgroundTint="#1e40af"
                android:layout_marginEnd="4dp"/>
            <Button
                android:id="@+id/btnLockB3B40"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="B3+B40"
                android:textSize="12sp"
                android:backgroundTint="#1e40af"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnLockB1B3B7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔥 B1 + B3 + B7 (Max Speed)"
            android:backgroundTint="#7c3aed"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnLockB1B3B28"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📡 B1 + B3 + B28 (5G Anchor)"
            android:backgroundTint="#065f46"
            android:layout_marginBottom="8dp"/>

        <!-- 5G NR Band Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5G NR BANDS"
            android:textColor="#06b6d4"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp"/>

        <!-- Single NR Bands -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btnLockN28"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="n28\n700"
                android:textSize="12sp"
                android:backgroundTint="#0e7490"
                android:layout_marginEnd="4dp"/>
            <Button
                android:id="@+id/btnLockN41"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="n41\n2500"
                android:textSize="12sp"
                android:backgroundTint="#0e7490"
                android:layout_marginEnd="4dp"/>
            <Button
                android:id="@+id/btnLockN78"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="n78\n3500"
                android:textSize="12sp"
                android:backgroundTint="#0e7490"/>
        </LinearLayout>

        <!-- NR-CA Combos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NR CARRIER AGGREGATION"
            android:textColor="#0891b2"
            android:textSize="12sp"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btnLockN28N78"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="n28+n78"
                android:textSize="12sp"
                android:backgroundTint="#155e75"
                android:layout_marginEnd="4dp"/>
            <Button
                android:id="@+id/btnLockN41N78"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="n41+n78"
                android:textSize="12sp"
                android:backgroundTint="#155e75"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnLockN28N41N78"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔥 n28 + n41 + n78 (Max 5G CA)"
            android:backgroundTint="#0d9488"
            android:layout_marginBottom="8dp"/>

        <!-- LTE + NR Combos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LTE + NR COMBO"
            android:textColor="#0891b2"
            android:textSize="12sp"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btnLockB3N78"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="B3 + n78"
                android:textSize="12sp"
                android:backgroundTint="#164e63"
                android:layout_marginEnd="4dp"/>
            <Button
                android:id="@+id/btnLockB3N28N78"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="B3+n28+n78"
                android:textSize="12sp"
                android:backgroundTint="#164e63"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnLockB1B3B28N78"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚀 B1+B3+B28 + n28+n78 (Full 5G)"
            android:backgroundTint="#115e59"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnUnlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔓 UNLOCK ALL BANDS"
            android:backgroundTint="#ef4444"/>

    </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
